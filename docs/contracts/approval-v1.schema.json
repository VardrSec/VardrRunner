{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "vardr.execution-approval/1"
    },
    "issuer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      },
      "required": [
        "id",
        "key_id"
      ],
      "additionalProperties": false
    },
    "origin": {
      "enum": [
        "standalone",
        "map"
      ]
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "approver_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "approved_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "context": {
      "type": "object",
      "properties": {
        "runner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "engagement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "authority_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authority_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "enum": [
            "strict",
            "advisory"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "pattern": "^https?://"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "method": {
                "enum": [
                  "GET",
                  "HEAD",
                  "OPTIONS",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "excluded": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "origin",
              "path",
              "method",
              "excluded",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "pattern": "^https?://"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "method": {
                "enum": [
                  "GET",
                  "HEAD",
                  "OPTIONS",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "excluded": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "origin",
              "path",
              "method",
              "excluded",
              "reason"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "not_before": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "testing_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "testing_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        },
        "max_executions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_http_dispatches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "credential_grants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "identity_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
              },
              "source": {
                "enum": [
                  "value_env",
                  "value_keychain"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "expires_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
              }
            },
            "required": [
              "identity_id",
              "source",
              "name",
              "revision",
              "expires_at"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "control": {
          "enum": [
            "local_offline",
            "managed_online"
          ]
        }
      },
      "required": [
        "runner_id",
        "engagement_id",
        "job_id",
        "authority_revision",
        "authority_sha256",
        "plan_sha256",
        "mode",
        "scope",
        "exceptions",
        "not_before",
        "expires_at",
        "testing_start",
        "testing_end",
        "max_executions",
        "max_duration_seconds",
        "max_http_dispatches",
        "max_artifact_bytes",
        "credential_grants",
        "control"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "issuer",
    "origin",
    "approval_id",
    "approver_id",
    "approved_at",
    "context"
  ],
  "additionalProperties": false
}
