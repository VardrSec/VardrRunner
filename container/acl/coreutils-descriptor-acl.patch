+
+/* O_PATH pins objects without opening devices or FIFOs, but cannot be used
+   with f*xattr. Follow only these descriptor aliases, never caller pathnames.
+   Linux bounds xattr lists and values to XATTR_LIST_MAX/XATTR_SIZE_MAX bytes; using that
+   bound avoids a size-query race without unbounded allocation or retries. */
+static int
+copy_acl_opath (char const *src, char const *dst)
+{
+  char *names = malloc (XATTR_LIST_MAX);
+  char *value = malloc (XATTR_SIZE_MAX);
+  int ret = -2;
+  if (!names || !value)
+    {
+      errno = ENOMEM;
+      goto done;
+    }
+  ssize_t size = listxattr (src, names, XATTR_LIST_MAX);
+  if (size < 0)
+    {
+      if (errno == ENOSYS || errno == ENOTSUP)
+        ret = 0;
+      goto done;
+    }
+  for (char *name = names; name < names + size; )
+    {
+      char *end = memchr (name, 0, names + size - name);
+      if (!end)
+        {
+          errno = EIO;
+          goto done;
+        }
+      if (*name && is_attr_permissions (name, NULL))
+        {
+          ssize_t length = getxattr (src, name, value, XATTR_SIZE_MAX);
+          if (length < 0)
+            goto done;
+          if (setxattr (dst, name, value, length, 0) < 0)
+            {
+              ret = -1;
+              goto done;
+            }
+        }
+      name = end + 1;
+    }
+  ret = 0;
+ done:
+  {
+    int saved = errno;
+    free (value);
+    free (names);
+    errno = saved;
+  }
+  return ret;
+}
