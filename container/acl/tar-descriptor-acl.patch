+/* Use libacl 2.4's anchored API; never the legacy chdir/path fallback. */
+static acl_t
+tar_acl_get_file_at (int parent, char const *name, acl_type_t type)
+{
+  return acl_get_file_at (parent, name,
+                          dereference_option ? 0 : AT_SYMLINK_NOFOLLOW, type);
+}
+
+static int
+tar_acl_set_file_at (int parent, char const *name, acl_type_t type, acl_t acl)
+{
+  return acl_set_file_at (parent, name, AT_SYMLINK_NOFOLLOW, type, acl);
+}
+
+static int
+tar_acl_delete_def_file_at (int parent, char const *name)
+{
+  return acl_delete_def_file_at (parent, name, AT_SYMLINK_NOFOLLOW);
+}
