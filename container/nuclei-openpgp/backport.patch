+package github
+import("testing";"strings";"time";"bytes";"github.com/ProtonMail/go-crypto/openpgp";"github.com/ProtonMail/go-crypto/openpgp/packet")
+func TestCryptoCompatibilityAudit(t *testing.T){
+ keys,err:=openpgp.ReadArmoredKeyRing(strings.NewReader(testGPGKey));if err!=nil{t.Fatal(err)};e:=keys[0];s,id:=e.PrimarySelfSignature();now:=time.Now();t.Logf("primary created=%s algorithm=%v selfsig=%v id=%v",e.PrimaryKey.CreationTime,e.PrimaryKey.PubKeyAlgo,s!=nil,id!=nil)
+ if s!=nil{t.Logf("keyExpired=%v sigExpired=%v revoked=%v flagsValid=%v flagSign=%v lifetime=%v",e.PrimaryKey.KeyExpired(s,now),s.SigExpired(now),e.Revoked(now),s.FlagsValid,s.FlagSign,s.KeyLifetimeSecs);if s.KeyLifetimeSecs!=nil{t.Logf("expiry=%s",e.PrimaryKey.CreationTime.Add(time.Duration(*s.KeyLifetimeSecs)*time.Second))}}
+ fresh,err:=openpgp.NewEntity("compatibility fixture","","fixture@example.invalid",&packet.Config{RSABits:2048});if err!=nil{t.Fatal(err)};var sig bytes.Buffer;msg:="isolated compatibility fixture";if err=openpgp.ArmoredDetachSign(&sig,fresh,strings.NewReader(msg),nil);err!=nil{t.Fatal(err)};if _,err=openpgp.CheckArmoredDetachedSignature(openpgp.EntityList{fresh},strings.NewReader(msg),&sig,nil);err!=nil{t.Fatal(err)};t.Log("fresh RSA2048 sign/verify roundtrip passed under default policy")
+}
+func TestExpiredLegacySigningKeyRejected(t *testing.T){
