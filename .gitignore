# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/
*.test

# Local runner state (mirrors ~/.vardrmap, never commit)
config.json
runs/

# Scratch space (never commit work-in-progress experiments)
scratch/

# Isolated validation dependencies and disposable pytest fixtures.
/.validation-deps/
/.pytest-evidence-validation-*/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

/.pytest-compose-validation/

# Agent-local credentials and session state.
.claude/settings.local.json
.claude/*.local.json
.claude/.credentials.json
.claude/projects/
.claude/history.jsonl
.codex/auth.json
.codex/config.local.toml
.codex/sessions/
.codex/history.jsonl
.mcp.local.json

# Local working notes and agent instructions are not published artifacts.
AGENTS.md
CLAUDE.md
/.private-notes/
/internal-notes/
/VardrSec-Internal-Notes/

# Private planning, decision records and acceptance receipts stay outside this repository.
/docs/adr/
/docs/evidence/
/docs/*roadmap*
/docs/*handoff*
/docs/*checkpoint*
/docs/*development-notes*
/docs/architecture.md
/docs/development.md

# Unpublished development fragments belong in local notes; public changes go in CHANGELOG.md.
/changelog/nm*.md
/changelog/unreleased*.md
